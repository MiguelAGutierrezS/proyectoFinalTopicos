# ==============================================================================
# LocalGem Chat — Configuración de Backend (.env)
# ==============================================================================
# Copia este archivo a 'backend/.env' para personalizar tu entorno local.

# ------------------------------------------------------------------------------
# 1. Base de Datos SQLite
# ------------------------------------------------------------------------------
# Ruta de conexión SQLite gestionada con SQLAlchemy. Por defecto localgem.db en backend/
DATABASE_URL=sqlite:///./localgem.db

# ------------------------------------------------------------------------------
# 2. Servidor Local de Ollama (http://localhost:11434)
# ------------------------------------------------------------------------------
# URL base donde corre tu instancia de Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modelo por defecto a usar si no se especifica otro desde la interfaz
OLLAMA_DEFAULT_MODEL=llama3.2:latest

# ------------------------------------------------------------------------------
# 3. Context Compactor (Gestor de memoria larga estilo Claude Code)
# ------------------------------------------------------------------------------
# Número de mensajes totales en el chat para disparar la compactación automática
COMPACTION_THRESHOLD=14

# Límite estimado de tokens en el historial antes de activar compactación (~4 chars por token)
# Para modelos de 4096 tokens de ventana de contexto, 3200 deja margen seguro
TOKEN_BUDGET=3200

# Cuántos mensajes recientes se mantienen intactos después de compactar los antiguos
RECENT_WINDOW_AFTER_COMPACTION=4

# Temperatura para el prompt del compactor (baja para resúmenes técnicos precisos)
COMPACTOR_TEMPERATURE=0.2

# Modelo específico para compactar (déjalo vacío para usar el mismo modelo activo)
# Ejemplos: llama3.2:1b, qwen2.5:0.5b (modelos ultraligeros para resúmenes rápidos)
COMPACTOR_MODEL=

# ------------------------------------------------------------------------------
# 4. Procesador Multimodal y Transcripción de Audio
# ------------------------------------------------------------------------------
# Tamaño del modelo faster-whisper en CPU int8: tiny, base, small
WHISPER_MODEL_SIZE=tiny
